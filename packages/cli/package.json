{
  "name": "sentry",
  "version": "0.40.0-dev.0",
  "description": "Sentry CLI - A command-line interface for using Sentry built by robots and humans for robots and humans",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsentry/cli.git"
  },
  "main": "./dist/index.cjs",
  "type": "module",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "sentry": "./dist/bin.cjs"
  },
  "files": [
    "dist/bin.cjs",
    "dist/index.cjs",
    "dist/index.mjs",
    "dist/index.d.cts",
    "dist/index.d.mts",
    "dist/ink-app.js",
    "dist/node-sqlite3-wasm.wasm",
    "dist/vendor/symbolic_bg.wasm"
  ],
  "license": "FSL-1.1-Apache-2.0",
  "engines": {
    "node": ">=18.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.15"
    }
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "tsx": "tsx",
    "cli": "tsx --import ./script/require-shim.mjs src/bin.ts",
    "dev": "tsx --import ./script/require-shim.mjs src/bin.ts",
    "build": "SENTRY_CLIENT_ID=${SENTRY_CLIENT_ID:-} pnpm run bundle && SENTRY_CLIENT_ID=${SENTRY_CLIENT_ID:-} tsx --import ./script/require-shim.mjs script/build.ts",
    "build:all": "SENTRY_CLIENT_ID=${SENTRY_CLIENT_ID:-} tsx --import ./script/require-shim.mjs script/build-all.ts",
    "bundle": "tsx --import ./script/require-shim.mjs script/bundle.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --no-errors-on-unmatched ./",
    "lint:fix": "biome check --write --no-errors-on-unmatched ./",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm run generate:docs && pnpm run generate:sdk && vitest run test/lib test/commands test/types test/script --coverage",
    "test:changed": "tsx --import ./script/require-shim.mjs script/test-changed.ts",
    "test:e2e": "pnpm run generate:docs && tsx --import ./script/require-shim.mjs script/test-e2e.ts",
    "test:init-eval": "tsx --import ./script/require-shim.mjs script/test-init-eval.ts",
    "generate:parser": "tsx --import ./script/require-shim.mjs script/generate-parser.ts",
    "generate:sdk": "tsx --import ./script/require-shim.mjs script/generate-sdk.ts",
    "generate:skill": "tsx --import ./script/require-shim.mjs script/generate-skill.ts",
    "generate:banner": "tsx --import ./script/require-shim.mjs script/generate-banner.ts",
    "generate:docs": "tsx --import ./script/require-shim.mjs script/generate-command-docs.ts && tsx --import ./script/require-shim.mjs script/generate-skill.ts && tsx --import ./script/require-shim.mjs script/generate-docs-sections.ts",
    "generate:docs-sections": "tsx --import ./script/require-shim.mjs script/generate-docs-sections.ts",
    "generate:schema": "tsx --import ./script/require-shim.mjs script/generate-schema.ts",
    "generate:command-docs": "tsx --import ./script/require-shim.mjs script/generate-command-docs.ts",
    "eval:skill": "tsx --import ./script/require-shim.mjs script/eval-skill.ts",
    "bench": "tsx --import ./script/require-shim.mjs script/bench.ts",
    "bench:save": "tsx --import ./script/require-shim.mjs script/bench.ts --save",
    "bench:compare": "tsx --import ./script/require-shim.mjs script/bench.ts --compare",
    "bench:sweep": "tsx --import ./script/require-shim.mjs script/bench-sweep.ts",
    "check:fragments": "tsx --import ./script/require-shim.mjs script/check-fragments.ts",
    "check:deps": "tsx --import ./script/require-shim.mjs script/check-deps.ts",
    "check:errors": "tsx --import ./script/require-shim.mjs script/check-errors.ts",
    "check:patches": "tsx --import ./script/require-shim.mjs script/check-patches.ts",
    "check:docs-sections": "tsx --import ./script/require-shim.mjs script/check-docs-sections.ts",
    "check:stale-refs": "tsx --import ./script/require-shim.mjs script/check-stale-refs.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@biomejs/biome": "2.3.8",
    "@clack/prompts": "0.11.0",
    "@hono/node-server": "^2.0.6",
    "@mastra/client-js": "^1.26.0",
    "@sentry/api": "^0.253.0",
    "@sentry/core": "10.63.0",
    "@sentry/node-core": "10.63.0",
    "@sentry/sqlish": "^1.0.1",
    "@sentry/symbolic": "13.7.0",
    "@spotlightjs/spotlight": "^4.11.7",
    "@stricli/auto-complete": "^1.2.8",
    "@stricli/core": "1.2.8",
    "@types/http-cache-semantics": "^4.2.0",
    "@types/node": "^22.20.0",
    "@types/picomatch": "^4.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.17",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.9",
    "binpatch": "^0.3.1",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "consola": "^3.4.2",
    "esbuild": "^0.28.1",
    "fast-check": "^4.8.0",
    "fflate": "^0.8.3",
    "fossilize": "^0.10.1",
    "hono": "^4.12.27",
    "http-cache-semantics": "^4.2.0",
    "ignore": "^7.0.5",
    "image-size": "^2.0.2",
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "jpeg-js": "^0.4.4",
    "marked": "^15.0.12",
    "node-sqlite3-wasm": "0.8.59",
    "p-limit": "^7.3.0",
    "peggy": "^5.1.0",
    "picomatch": "^4.0.4",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "pretty-ms": "^9.3.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1",
    "semver": "^7.8.5",
    "string-width": "^8.2.1",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "ultracite": "6.3.10",
    "uuidv7": "^1.2.1",
    "vitest": "^4.1.9",
    "wrap-ansi": "^10.0.0",
    "zod": "^3.25.76"
  }
}
